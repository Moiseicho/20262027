Cell[BoxData[{"\"\<Gaussian matrix solve:\n+ simple\n+ gives exact answers\n- \
slow O(\!\(\*SuperscriptBox[\(n\), \(3\)]\))\n- instability for round errors\n\
- requires pivoting to minimize error and substitutions when necesary to \
avoid division by 0\n\>\"", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Gauss", "[", 
    RowBox[{"AIn_", ",", "bIn_"}], "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"A", "=", "AIn"}], ",", "\[IndentingNewLine]", 
        RowBox[{"b", "=", "bIn"}], ",", "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "A", "]"}]}], ",", "\[IndentingNewLine]", "i",
         ",", "\[IndentingNewLine]", "j", ",", "\[IndentingNewLine]", "k", 
        ",", "\[IndentingNewLine]", "temp", ",", "\[IndentingNewLine]", 
        "answer"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"answer", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", "n"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"maxIndex", "=", "i"}], ";", "\[IndentingNewLine]", 
          RowBox[{"maxVal", "=", 
           RowBox[{"A", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", 
             RowBox[{"i", "+", "1"}]}], ",", 
            RowBox[{"j", "<=", "n"}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"A", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "i"}], "]"}], "]"}], "]"}], "<", 
                RowBox[{"Abs", "[", 
                 RowBox[{"A", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", ",", "i"}], "]"}], "]"}], "]"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"maxIndex", "=", "j"}], ";", "\[IndentingNewLine]", 
                RowBox[{"maxVal", "=", 
                 RowBox[{"A", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", ",", "i"}], "]"}], "]"}]}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"temp", "=", 
           RowBox[{"A", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "=", 
           RowBox[{"A", "[", 
            RowBox[{"[", "maxIndex", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"A", "[", 
            RowBox[{"[", "maxIndex", "]"}], "]"}], "=", "temp"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"temp", "=", 
           RowBox[{"b", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"b", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "=", 
           RowBox[{"b", "[", 
            RowBox[{"[", "maxIndex", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"b", "[", 
            RowBox[{"[", "maxIndex", "]"}], "]"}], "=", "temp"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"A", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "i"}], "]"}], "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{"A", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
             SuperscriptBox["10", 
              RowBox[{"-", "12"}]]}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", 
             RowBox[{"i", "+", "1"}]}], ",", 
            RowBox[{"j", "<=", "n"}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"coef", "=", 
              FractionBox[
               RowBox[{"A", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "i"}], "]"}], "]"}], 
               RowBox[{"A", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "i"}], "]"}], "]"}]]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"A", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "-=", 
              RowBox[{"coef", "*", 
               RowBox[{"A", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"b", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "-=", 
              RowBox[{"coef", "*", 
               RowBox[{"b", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}]}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "n"}], ",", 
         RowBox[{"i", ">=", "1"}], ",", 
         RowBox[{"i", "--"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"answer", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "=", 
           FractionBox[
            RowBox[{
             RowBox[{"b", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", 
             RowBox[{"Dot", "[", 
              RowBox[{
               RowBox[{"A", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "answer"}], "]"}]}], 
            RowBox[{"A", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "i"}], "]"}], "]"}]]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "answer"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
    ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2", ",", "3"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Gauss", "[", 
  RowBox[{"A", ",", "b"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"LinearSolve", "[", 
  RowBox[{"A", ",", "b"}], "]"}]}], "Input",
 CellChangeTimes->{{4.00356100752312*^9, 4.0035610508262205`*^9}, {
   4.0035610852708673`*^9, 4.0035616935742655`*^9}, {4.003561724151233*^9, 
   4.003561725106036*^9}, {4.003561787201722*^9, 4.0035617882184525`*^9}, {
   4.003561828303486*^9, 4.0035620680450926`*^9}, {4.0035621039466553`*^9, 
   4.0035621088594313`*^9}, {4.003562226060235*^9, 4.0035622547131968`*^9}, {
   4.0035625507897844`*^9, 4.0035625551889095`*^9}, {4.0035628569687195`*^9, 
