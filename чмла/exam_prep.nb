Cell[BoxData[{"\"\<LU:\n~ 0(\!\(\*SuperscriptBox[\(n\), \(3\)]\)) for \
factorization, but O(\!\(\*SuperscriptBox[\(n\), \(2\)]\)) for subsequent \
solves.\n+ easy Inverse and determinant calculations\n- Similiar to Gaussian \
elimination\n\>\"", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LU", "[", "AIn_", "]"}], ":=", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"U", "=", "AIn"}], ",", "\[IndentingNewLine]", 
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "AIn", "]"}]}], ",", "\[IndentingNewLine]", 
         "i", ",", "\[IndentingNewLine]", "j", ",", "\[IndentingNewLine]", 
         "L"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"L", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"i", "==", "j"}], ",", "1", ",", "0"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", "n"}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", 
             RowBox[{"i", "+", "1"}]}], ",", 
            RowBox[{"j", "<=", "n"}], ",", 
            RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"L", "[", 
               RowBox[{"[", 
                RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", 
              FractionBox[
               RowBox[{"U", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "i"}], "]"}], "]"}], 
               RowBox[{"U", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "i"}], "]"}], "]"}]]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"U", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "-=", 
              RowBox[{
               RowBox[{"U", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "*", 
               RowBox[{"L", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "i"}], "]"}], "]"}]}]}], ";"}]}], 
           "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"L", ",", "U"}], "}"}]}]}], "\[IndentingNewLine]", "]"}], 
     "\[IndentingNewLine]", ")"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"L", ",", "U"}], "}"}], "=", 
   RowBox[{"LU", "[", "A", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "/@", 
  RowBox[{"{", 
   RowBox[{"L", ",", "U"}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Dot", "[", 
    RowBox[{"L", ",", "U"}], "]"}], "//", "MatrixForm"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LUSolve", "[", 
    RowBox[{"LIn_", ",", "UIn_", ",", "bIn_"}], "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"L", "=", "LIn"}], ",", "\[IndentingNewLine]", 
        RowBox[{"U", "=", "UIn"}], ",", "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "L", "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"b", "=", "bIn"}], ",", "\[IndentingNewLine]", "i", ",", 
        "\[IndentingNewLine]", "j", ",", "\[IndentingNewLine]", "answer"}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"answer", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", "n"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"answer", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "=", 
           FractionBox[
            RowBox[{
             RowBox[{"b", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", 
             RowBox[{"Dot", "[", 
              RowBox[{
               RowBox[{"L", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "answer"}], "]"}]}], 
            RowBox[{"L", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "i"}], "]"}], "]"}]]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"b", "=", "answer"}], ";", "\[IndentingNewLine]", 
       RowBox[{"answer", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "n"}], ",", 
         RowBox[{"i", ">=", "1"}], ",", 
         RowBox[{"i", "--"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"answer", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "=", 
           FractionBox[
            RowBox[{
             RowBox[{"b", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", 
             RowBox[{"Dot", "[", 
              RowBox[{
               RowBox[{"U", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "answer"}], "]"}]}], 
            RowBox[{"U", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "i"}], "]"}], "]"}]]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       "answer"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
    ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LUSolve", "[", 
   RowBox[{"L", ",", "U", ",", "b"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LUInverse", "[", "AIn_", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"A", "=", "AIn"}], ",", "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "AIn", "]"}]}], ",", "\[IndentingNewLine]", 
        "i", ",", "\[IndentingNewLine]", "j", ",", "\[IndentingNewLine]", 
        "inverse"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"inverse", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"L", ",", "U"}], "}"}], "=", 
        RowBox[{"LU", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", "n"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"inverse", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "=", 
           RowBox[{"LUSolve", "[", 
            RowBox[{"L", ",", "U", ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"j", "==", "i"}], ",", "1", ",", "0"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "]"}]}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Transpose", "[", "inverse", "]"}]}]}], "\[IndentingNewLine]", 
     "]"}], "\[IndentingNewLine]", ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AInv", "=", 
   RowBox[{"LUInverse", "[", "A", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"AInv", "//", "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{"Dot", "[", 
  RowBox[{"A", ",", "AInv"}], "]"}]}], "Input",
