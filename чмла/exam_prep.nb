Cell[BoxData[{
 RowBox[{"\"\<Tridiagonal:\n+O(n)\n+ small memory req\n\n- Instablitly \
without pivoting\n- Strict Domain\n\>\"", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TridiagonalSolve", "[", 
    RowBox[{"AIn_", ",", "bIn_"}], "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"A", "=", "AIn"}], ",", "\[IndentingNewLine]", 
        RowBox[{"b", "=", "bIn"}], ",", "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "A", "]"}]}], ",", "\[IndentingNewLine]", "i",
         ",", "\[IndentingNewLine]", "j", ",", "\[IndentingNewLine]", "alpha",
         ",", "\[IndentingNewLine]", "beta", ",", "\[IndentingNewLine]", 
        "answer"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"alpha", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"beta", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"answer", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"alpha", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "=", 
        FractionBox[
         RowBox[{"A", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], 
         RowBox[{"-", 
          RowBox[{"A", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}]}]]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"beta", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "=", 
        FractionBox[
         RowBox[{"b", "[", 
          RowBox[{"[", "1", "]"}], "]"}], 
         RowBox[{"A", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "2"}], ",", 
         RowBox[{"i", "<", "n"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"alpha", "[", 
            RowBox[{"[", 
             RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
           FractionBox[
            RowBox[{"A", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", 
               RowBox[{"i", "+", "1"}]}], "]"}], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"A", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "i"}], "]"}], "]"}]}], "-", 
              RowBox[{
               RowBox[{"A", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", 
                  RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "*", 
               RowBox[{"alpha", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}]}], ")"}]]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"beta", "[", 
            RowBox[{"[", 
             RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
           FractionBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"A", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", 
                  RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "*", 
               RowBox[{"beta", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "-", 
              RowBox[{"b", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"A", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "i"}], "]"}], "]"}]}], "-", 
              RowBox[{
               RowBox[{"A", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", 
                  RowBox[{"i", "-", "1"}]}], "]"}], "]"}], "*", 
               RowBox[{"alpha", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}]}], ")"}]]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"answer", "[", 
         RowBox[{"[", "n", "]"}], "]"}], "=", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"A", "[", 
             RowBox[{"[", 
              RowBox[{"n", ",", 
               RowBox[{"n", "-", "1"}]}], "]"}], "]"}], "*", 
            RowBox[{"beta", "[", 
             RowBox[{"[", "n", "]"}], "]"}]}], "-", 
           RowBox[{"b", "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"A", "[", 
             RowBox[{"[", 
              RowBox[{"n", ",", "n"}], "]"}], "]"}]}], "-", 
