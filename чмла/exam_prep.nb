             RowBox[{"[", "n", "]"}], "]"}]}]}], ")"}]]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", 
          RowBox[{"n", "-", "1"}]}], ",", 
         RowBox[{"i", ">=", "1"}], ",", 
         RowBox[{"i", "--"}], ",", "\[IndentingNewLine]", 
